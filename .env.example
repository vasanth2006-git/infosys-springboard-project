MYSQL_USER=root
MYSQL_PASSWORD=your_actual_mysql_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=shopsense_new_db
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Service Configuration for Weekly Vendor Reports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=True
EMAIL_FROM=reports@shopsense.com

# In-App Weekly Scheduler Configuration
WEEKLY_AGENT_ENABLED=True
WEEKLY_AGENT_INTERVAL_DAYS=7
